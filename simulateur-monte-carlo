function runProjection(){
  buildStratRows();
  const assets = getAssets().filter(a=>a.weight>0);
  const totalW = assets.reduce((s,a)=>s+a.weight,0)||1;
  const totalValue = parseFloat(document.getElementById('stratValue').value)||0;
  const dca = parseFloat(document.getElementById('dcaAmount').value)||0;
  const dcaMonths = {mensuel:1,bimestriel:2,trimestriel:3}[document.getElementById('dcaFreq').value];
  const rebalMonths = parseInt(document.getElementById('rebalFreq').value)||12;
  const rows = [...document.querySelectorAll('#stratBody tr')];
  const names = rows.map(tr=>tr.dataset.name);
  const targetsRaw = rows.map(tr=>parseFloat((tr.querySelector('[data-f="target"]').value||'0').replace(',','.'))||0);
  const targetSum = targetsRaw.reduce((a,b)=>a+b,0)||1;
  const targets = targetsRaw.map(v=>v/targetSum);
  const initValues = names.map(n=>{ const a=assets.find(x=>x.name===n); return a ? (a.weight/totalW)*totalValue : 0; });
  const rets = names.map(n=>{ const a=assets.find(x=>x.name===n); return a?a.ret:0; });
  let values = initValues.slice();
  const now = new Date();
  const mapping = {year_end: 11-now.getMonth(), '1y':12, '2y':24, '5y':60};
  const monthsTotal = Math.max(0, mapping[document.getElementById('projHorizon').value]);
  for(let m=1;m<=monthsTotal;m++){
    values = values.map((v,i)=> v*(1+rets[i]/12));
    if(dca>0 && m%dcaMonths===0){
      const tot = values.reduce((s,v)=>s+v,0)||1;
      const gaps = values.map((v,i)=> targets[i]*100 - (v/tot*100));
      const posSum = gaps.reduce((s,g)=>s+Math.max(g,0),0)||1;
      values = values.map((v,i)=> v + Math.max(gaps[i],0)/posSum*dca);
    }
    if(m%rebalMonths===0){
      const tot = values.reduce((s,v)=>s+v,0);
      values = targets.map(tg=> tg*tot);
    }
  }
  const totalFinal = values.reduce((s,v)=>s+v,0)||1;
  const fmt = fmtMoney;
  document.getElementById('projTable').innerHTML = `
    <table><thead><tr><th>${t('projColAsset')}</th><th>${t('projColCurrent')}</th><th>${t('projColProjected')}</th><th>${t('projColWeight')}</th></tr></thead>
    <tbody>${names.map((n,i)=>`<tr><td>${n}</td><td>${fmt(initValues[i])}</td><td>${fmt(values[i])}</td><td>${(values[i]/totalFinal*100).toFixed(1)}%</td></tr>`).join('')}</tbody></table>
    <p style="color:var(--muted);font-size:.82rem;margin-top:.6rem;">${t('projFooter', fmt(totalFinal), monthsTotal)}</p>
  `;
}
