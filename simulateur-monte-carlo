// Core fetch logic shared by the per-row button and the "fetch all" bulk action.
// Returns {ok:true, usdPrice, price} or {ok:false, reason, ...details} — never throws.
function parseCsvResult(raw){
  const csv = typeof raw === 'string' ? raw : raw?.result;
  if(typeof csv !== 'string') return null;
  const lines = csv.split(/\r?\n/).filter(l=>l.length>0);
  if(lines.length < 1) return [];
  const headers = lines[0].split(',').map(h=>h.trim());
  return lines.slice(1).map(line=>{
    const vals = line.split(',');
    const obj = {};
    headers.forEach((h,i)=> obj[h] = (vals[i]||'').trim());
    return obj;
  });
}
function checkApiError(result){
  const err = result && result.error;
  if(!err) return null;
  return {type: err.type || 'error', message: err.message || err.detail || JSON.stringify(err)};
}
async function fetchPriceCore(tr){
  const ticker = tr.querySelector('[data-f="ticker"]').value.trim();
  const isin = tr.querySelector('[data-f="isin"]').value.trim();
  const cat = tr.querySelector('[data-f="cat"]').value;
  const isCrypto = cat === 'crypto';
  const isMetal = cat === 'metaux';
  const symbol = ticker || (!isCrypto && !isMetal ? isin : '');
  if(!symbol) return {ok:false, reason:'no-identifier'};
  try{
    const mcp = (window.claude && window.claude.use) ? await window.claude.use('mcp') : null;
    if(!mcp) return {ok:false, reason:'no-mcp'};
    const serverName = isCrypto ? 'CoinMarketCap' : (isMetal ? 'FMP' : 'Alpha Vantage MCP Server');
    const server = await mcp.server(serverName);
    if(!server) return {ok:false, reason:'no-server', serverName};
    let result;
    if(isCrypto){
      const CMC_IDS = {BTC:1,ETH:1027,SOL:5426,USDT:825,BNB:1839,XRP:52,ADA:2010,DOGE:74,AVAX:5805,LINK:1975,LTC:2,DOT:6636,MATIC:3890,SHIB:5994,TRX:1958,USDC:3408,TON:11419,BCH:1831,NEAR:6535,XLM:512};
      const id = /^\d+$/.test(symbol) ? symbol : CMC_IDS[symbol.toUpperCase()];
      if(!id) return {ok:false, reason:'unknown-cmc', symbol};
      result = await server.get_crypto_quotes_latest({id: String(id)});
    } else if(isMetal){
      // FMP commodities endpoint — confirmed working, gives the real spot price per troy ounce in USD.
      const METAL_CODES = {OR:'GCUSD', GOLD:'GCUSD', XAU:'GCUSD', ARGENT:'SIUSD', SILVER:'SIUSD', XAG:'SIUSD'};
      const code = METAL_CODES[symbol.toUpperCase()];
      if(!code) return {ok:false, reason:'unknown-metal', symbol};
      result = await server.commodity({endpoint: 'commodities-quote-short', symbol: code});
    } else {
      result = await server.GLOBAL_QUOTE({symbol}); // falls back to the ISIN when no ticker was given — Alpha Vantage mostly expects US-style tickers, so this may not resolve for every European ISIN
    }
    console.log('fetchPriceCore raw result ('+serverName+' / '+symbol+'):', result);
    const apiErr = checkApiError(result);
    if(apiErr) return {ok:false, reason:'api-error', apiErr, symbol};
    let usdPrice = null;
    try{
      if(isCrypto){
        const d = Array.isArray(result) ? result[0] : (Object.values(result?.data||{})[0] ?? result);
        usdPrice = d?.price ?? d?.quote?.USD?.price ?? null;
      } else if(isMetal){
        const d = Array.isArray(result) ? result[0] : result;
        usdPrice = d?.price ?? null;
      } else {
        const rows = parseCsvResult(result);
        const q = (rows && rows[0]) || result?.['Global Quote'] || result;
        usdPrice = parseFloat(q?.price ?? q?.close ?? q?.['05. price'] ?? NaN);
      }
    }catch(e){ usdPrice = null; }
    if(usdPrice!=null && !isNaN(usdPrice)) return {ok:true, usdPrice, price: usdToDisplay(usdPrice), symbol};
    return {ok:false, reason:'parse', raw:result, symbol};
  }catch(e){
    return {ok:false, reason:'error', error:e, symbol};
  }
}

// Returns {ok:true, matches:[{sym,nm,region}]} or {ok:false, reason, raw?}
async function searchSymbolCore(name){
  try{
    const mcp = (window.claude && window.claude.use) ? await window.claude.use('mcp') : null;
    if(!mcp) return {ok:false, reason:'no-mcp'};
    const server = await mcp.server('Alpha Vantage MCP Server');
    if(!server) return {ok:false, reason:'no-server'};
    const result = await server.SYMBOL_SEARCH({keywords: name});
    console.log('searchSymbolCore raw result for "'+name+'":', result);
    const apiErr = checkApiError(result);
    if(apiErr) return {ok:false, reason:'api-error', apiErr};
    const csvRows = parseCsvResult(result);
    const raw = (csvRows && csvRows.length) ? csvRows : (result?.bestMatches || result?.matches || (Array.isArray(result)?result:null));
    if(!raw || !raw.length) return {ok:false, reason:'empty', raw: result};
    const matches = raw.slice(0,8).map(m=>({
      sym: m.symbol ?? m['1. symbol'] ?? '?',
      nm: m.name ?? m['2. name'] ?? '',
      region: m.region ?? m['4. region'] ?? ''
    }));
    return {ok:true, matches};
  }catch(e){
    return {ok:false, reason:'error', error:e};
  }
}
