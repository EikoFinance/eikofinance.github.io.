  const targetRows = alloc ? `<div style="margin:1rem 0;"><b style="font-size:.85rem;">${t('adviceTargetTitle', goalLabel)}</b>
    ${Object.keys(CATS).map(k=>`<div class="catrow"><span>${catLabel(k)}</span><span>${alloc[k]}%</span></div>`).join('')}
    <div class="catrow" style="font-weight:600;"><span>${t('adviceTargetSum')}</span><span>${Object.values(alloc).reduce((a,b)=>a+b,0)}%</span></div></div>` : '';

  document.getElementById('adviceContent').innerHTML = `<div style="margin-bottom:1rem;">${rows}</div>${targetRows}<ul>${tips.map(x=>`<li>${x}</li>`).join('')}</ul><p style="color:var(--muted);font-size:.82rem;">${t('adviceFooter')}</p>`;
}
