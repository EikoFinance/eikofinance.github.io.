    {tab:'t7', target:null, title:'Ready to start?', body:"Want to take your investor profile questionnaire now? It takes a few minutes and can guide everything that follows.", final:true}
  ]
};
let tutStep = 0;
// Scrolls the page so the target sits centered in the space ABOVE the fixed
// bottom sheet (not the full viewport), so it's never hidden behind the sheet.
function scrollTargetAboveSheet(targetEl){
  const sheet = document.getElementById('tutBox');
  const sheetH = sheet.offsetHeight || 220;
  const visibleH = Math.max(120, window.innerHeight - sheetH);
  const r = targetEl.getBoundingClientRect();
  const targetCenter = r.top + r.height/2;
  const delta = targetCenter - visibleH/2;
  window.scrollBy({top: delta, behavior:'smooth'});
}
let tutHighlighted = null;
function clearHighlight(){ if(tutHighlighted){ tutHighlighted.classList.remove('tutCoachTarget'); tutHighlighted = null; } }
function renderTutorial(){
  const steps = TUT_STEPS[LANG] || TUT_STEPS.fr;
  const s = steps[tutStep];
  clearHighlight();
  if(s.tab) switchTab(s.tab);
  if(s.target==='#computeProfile') setQuizVisible(true);
  document.getElementById('tutTitle').textContent = s.title;
  document.getElementById('tutBody').textContent = s.body;
  document.getElementById('tutDots').innerHTML = steps.map((_,i)=>`<span class="${i===tutStep?'active':''}"></span>`).join('');
  document.getElementById('tutPrev').style.visibility = tutStep===0 ? 'hidden' : 'visible';
  document.getElementById('tutPrev').textContent = t('tutPrev');
  document.getElementById('tutSkip').textContent = t('tutSkip');
  document.getElementById('tutNext').textContent = s.final ? t('tutStartProfile') : t('tutNext');
  const scrim = document.getElementById('tutScrim');
  const targetEl = s.target ? document.querySelector(s.target) : null;
  if(targetEl){
    targetEl.classList.add('tutCoachTarget');
    tutHighlighted = targetEl;
    scrim.classList.remove('on');
    setTimeout(()=> scrollTargetAboveSheet(targetEl), 60);
  } else {
    scrim.classList.add('on');
    window.scrollTo({top:0, behavior:'smooth'});
  }
}
function closeTutorial(){
  clearHighlight();
  document.getElementById('tutScrim').classList.remove('on');
  document.getElementById('tutOverlay').style.display = 'none';
  try{ localStorage.setItem('eiko_web_tutorial_seen','1'); }catch(e){}
}
function openTutorial(){
  tutStep = 0;
  document.getElementById('tutOverlay').style.display = 'block';
  renderTutorial();
}
document.getElementById('tutPrev').onclick = () => { if(tutStep>0){ tutStep--; renderTutorial(); } };
document.getElementById('tutNext').onclick = () => {
  const steps = TUT_STEPS[LANG] || TUT_STEPS.fr;
  if(steps[tutStep].final){
    closeTutorial();
    switchTab('t7');
    document.getElementById('invAge')?.scrollIntoView({behavior:'smooth', block:'start'});
  } else if(tutStep < steps.length-1){
    tutStep++; renderTutorial();
  }
};
document.getElementById('tutSkip').onclick = closeTutorial;
window.addEventListener('resize', ()=>{ if(tutHighlighted) scrollTargetAboveSheet(tutHighlighted); });
document.getElementById('replayTutorialBtn').onclick = openTutorial;
document.getElementById('feedbackCopyBtn').onclick = async (e) => {
  const btn = e.currentTarget;
  try{
    await navigator.clipboard.writeText('ricardo.nibau@gmail.com');
    btn.textContent = t('feedbackCopied');
  }catch(err){
    btn.textContent = t('feedbackCopyBtn'); // clipboard unavailable — the address text above remains selectable manually
  }
  setTimeout(()=>{ btn.textContent = t('feedbackCopyBtn'); }, 1800);
};

/* ================= branding (Eiko Finance) ================= */
const EIKO_LOGO = 'data:image/png;base64,';
function wireEikoLogos(){
  ['eikoHeaderLogo','eikoSplashLogo'].forEach(id=>{
    const el = document.getElementById(id);
    if(el) el.src = EIKO_LOGO;
  });
}
wireEikoLogos();

// Startup splash: on screen from the first paint, torn down after 2 seconds.
const EIKO_SPLASH_MS = 2000;
function eikoRemoveSplash(){
  const sp = document.getElementById('eikoSplash');
  if(!sp) return;
  sp.classList.add('on');
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  setTimeout(()=>{ sp.remove(); }, reduce ? 60 : 620);
}

/* ================= init ================= */
setLang(savedLang);
let tutorialSeen = false;
try{ tutorialSeen = localStorage.getItem('eiko_web_tutorial_seen')==='1'; }catch(e){}
if(!tutorialSeen) openTutorial();

// The splash owns the screen until here: the document stayed visibility:hidden
// while it was up, so reveal it now that images are wired and fonts are applied.
requestAnimationFrame(()=>{ requestAnimationFrame(()=>{
  document.documentElement.style.visibility = 'visible';
  document.body.style.visibility = 'visible';
}); });
setTimeout(eikoRemoveSplash, EIKO_SPLASH_MS);
})();
</script>
