    if(g>0) totalGapValue += gEur;
    return g;
  });
  const curItems = rows.map((tr,i)=>[tr.dataset.name, parseFloat(tr.querySelector('.curCell').textContent)||0, PIE_PALETTE[i%PIE_PALETTE.length]]);
  const tgtItems = rows.map((tr,i)=>[tr.dataset.name, targets[i]/targetSum*100, PIE_PALETTE[i%PIE_PALETTE.length]]);
  document.getElementById('stratPies').innerHTML = [
    {label:t('stratCurrentAlloc'), items:curItems},
