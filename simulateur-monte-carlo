function profileAllocation(profile){
  const bandKeys=['prudent','equilibre','dynamique','offensif'];
  return PROFILE_ALLOC[bandKeys[profile.bandIdx]] || PROFILE_ALLOC.equilibre;
}
function assetsForProfileAllocation(baseAssets, allocation){
  const categoryWeights = {};
  for(const key in CATS) categoryWeights[key]=0;
  baseAssets.forEach(asset=> categoryWeights[asset.cat]=(categoryWeights[asset.cat]||0)+asset.weight);
  const availableTarget = Object.keys(allocation).reduce((sum,key)=>sum+(categoryWeights[key]>0 ? allocation[key] : 0),0);
  if(availableTarget<=0) return [];
  return baseAssets.map(asset=>({...asset,weight:categoryWeights[asset.cat]>0 ? (allocation[asset.cat]/availableTarget)*(asset.weight/categoryWeights[asset.cat]) : 0})).filter(asset=>asset.weight>0);
}
function missingProfileCategories(baseAssets, allocation){
  const available = new Set(baseAssets.map(asset=>asset.cat));
  return Object.keys(allocation).filter(key=>allocation[key]>0 && !available.has(key)).map(catLabel);
}

function simulateQuadrantMedian(baseAssets, qi, capital, years, nsim, contrib){
  const steps = years*12, dt=1/12;
  const assets = baseAssets.map(a=>{
    const c = CATS[a.cat] || CATS.actions;
    return { weight:a.weight, ret: a.ret + c.ret[qi]/100, vol: Math.max(0.01, a.vol * c.volMult[qi]) };
  });
  const cols = new Array(steps+1);
  for(let t=0;t<=steps;t++) cols[t] = new Float64Array(nsim);
  for(let s=0;s<nsim;s++){
    let value = capital;
    cols[0][s] = value;
    for(let t=1;t<=steps;t++){
      let pr = 0;
      for(const a of assets){
        const drift = (a.ret-0.5*a.vol*a.vol)*dt;
        const shock = a.vol*Math.sqrt(dt)*gaussian();
        pr += a.weight*(Math.exp(drift+shock)-1);
      }
      value = value*(1+pr);
      if(t%12===0) value += contrib;
      cols[t][s] = value;
    }
  }
  const median = new Float64Array(steps+1);
  for(let ti=0;ti<=steps;ti++){
    const arr = Array.from(cols[ti]).sort((a,b)=>a-b);
    median[ti] = arr[Math.floor(arr.length*0.5)];
  }
  return median;
}

function runSimulation(){
  const profileMode = document.getElementById('simProfileMode').value;
  const portfolioRaw = getAssets().filter(a=>a.weight>0);
  const profiles = loadSavedProfiles();
  let raw = portfolioRaw;
  let notice = '';
  if(profileMode==='combined'){
    if(profiles.length!==2){ notice=t('simNeedsProfiles'); }
    else {
      const firstContribution = parseFloat(document.getElementById('profile1Contribution').value)||0;
      const secondContribution = parseFloat(document.getElementById('profile2Contribution').value)||0;
      const contributionTotal = firstContribution+secondContribution;
      if(contributionTotal<=0) notice=t('simNeedsContribution');
      else {
        const firstShare=firstContribution/contributionTotal;
        const secondShare=secondContribution/contributionTotal;
        const firstAllocation=profileAllocation(profiles[0]);
        const secondAllocation=profileAllocation(profiles[1]);
        const firstAssets=portfolioRaw.filter(asset=>asset.ownerId===profiles[0].id);
        const secondAssets=portfolioRaw.filter(asset=>asset.ownerId===profiles[1].id);
        if((firstShare>0 && !firstAssets.length)||(secondShare>0 && !secondAssets.length)){
          notice=t('simProfileMissingAssets',firstShare>0 && !firstAssets.length ? profiles[0].name : profiles[1].name);
        } else {
          const firstTarget=firstShare>0 ? assetsForProfileAllocation(firstAssets,firstAllocation) : [];
          const secondTarget=secondShare>0 ? assetsForProfileAllocation(secondAssets,secondAllocation) : [];
          raw=[...firstTarget.map(asset=>({...asset,weight:asset.weight*firstShare})),...secondTarget.map(asset=>({...asset,weight:asset.weight*secondShare}))];
          notice=t('combinedShareSummary',profiles[0].name,Math.round(firstShare*100),profiles[1].name,Math.round(secondShare*100));
          if(!raw.length) notice=t('simNoAssets');
          else {
            const missing=[...(firstShare>0?missingProfileCategories(firstAssets,firstAllocation):[]),...(secondShare>0?missingProfileCategories(secondAssets,secondAllocation):[])];
            if(missing.length) notice+=` ${t('simMissingCategories',missing.join(', '))}`;
          }
        }
      }
    }
  } else if(profileMode.startsWith('profile:')){
    const profile=profiles.find(item=>`profile:${item.id}`===profileMode);
    const ownedAssets=profile ? portfolioRaw.filter(asset=>asset.ownerId===profile.id) : [];
    raw=profile ? assetsForProfileAllocation(ownedAssets,profileAllocation(profile)) : [];
    if(!raw.length) notice=t('simNoAssets');
    else {
      notice=t('profileResultTitle',profile.name,profile.score,117);
      const missing=missingProfileCategories(ownedAssets,profileAllocation(profile));
      if(missing.length) notice+=` ${t('simMissingCategories',missing.join(', '))}`;
    }
  }
  const noticeElement=document.getElementById('simProfileNotice');
  noticeElement.textContent=notice;
  noticeElement.style.display=notice ? 'block' : 'none';
  if(notice && raw===portfolioRaw && profileMode!=='portfolio') return;
  if(profileMode!=='portfolio' && !raw.length) return;
  const totalW = raw.reduce((s,a)=>s+a.weight,0) || 1;
  const assets = raw.map(a=>({...a, weight:a.weight/totalW}));
  const capital = parseFloat(document.getElementById('capital').value)||0;
  const years = parseInt(document.getElementById('years').value)||10;
  const contrib = parseFloat(document.getElementById('contrib').value)||0;
  const nsim = Math.min(1000, parseInt(document.getElementById('nsim').value)||300);
  const steps = years*12;
  const quadPaths = [];
  for(let qi=0; qi<4; qi++) quadPaths.push(simulateQuadrantMedian(assets, qi, capital, years, nsim, contrib));
  const avg = new Float64Array(steps+1);
  for(let ti=0;ti<=steps;ti++) avg[ti] = quadPaths.reduce((s,p)=>s+p[ti],0)/4;
  const series = quadPaths.map((p,i)=>({label:t('quad'+i), color:QUAD_COLORS[i], path:p, width:1.8}));
  series.sort((a,b)=> b.path[b.path.length-1] - a.path[a.path.length-1]); // best performer first
  series.push({label:t('quadAvg'), color:'#e2493a', path:avg, width:2.8});

  // Target-allocation comparison curve (uses the weights set in the Stratégie tab, if any)
  const hasTargets = profileMode==='portfolio' && portfolioRaw.some(a=> assetTargets[a.name]!==undefined);
  if(hasTargets){
    const targetRaw = portfolioRaw.map(a=> ({...a, weight: parseFloat((assetTargets[a.name]||'0').toString().replace(',','.'))||0}));
    const targetSum = targetRaw.reduce((s,a)=>s+a.weight,0) || 1;
    const targetAssets = targetRaw.map(a=>({...a, weight:a.weight/targetSum}));
    const targetQuadPaths = [];
    for(let qi=0; qi<4; qi++) targetQuadPaths.push(simulateQuadrantMedian(targetAssets, qi, capital, years, nsim, contrib));
    const targetAvg = new Float64Array(steps+1);
    for(let ti=0;ti<=steps;ti++) targetAvg[ti] = targetQuadPaths.reduce((s,p)=>s+p[ti],0)/4;
    series.push({label:t('quadAvgTarget'), color:'#0a84ff', path:targetAvg, width:2.8, dashed:true});
  }

  // Order: the 4 macro scenarios by final performance (best first), then average, then average vs target
  const quadSeries = series.slice(0,4).sort((a,b)=> b.path[b.path.length-1]-a.path[a.path.length-1]);
  const restSeries = series.slice(4);
  const orderedSeries = [...quadSeries, ...restSeries];

  document.getElementById('resultsPanel').style.display='block';
  document.getElementById('saveSimBtn').style.display='inline-block';
  document.getElementById('newSimBtn').style.display='inline-block';
  window.lastSeries = orderedSeries; window.lastSteps = steps; window.lastYears = years;
  drawChart(orderedSeries, steps, years);
  showQuadStats(orderedSeries, capital, contrib, years);
}

function drawChart(series, steps, years){
  const canvas = document.getElementById('chart');
  const dpr = window.devicePixelRatio||1;
  const w = canvas.clientWidth, h = 360;
  canvas.width = w*dpr; canvas.height = h*dpr;
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr,dpr);
  ctx.clearRect(0,0,w,h);
  const allVals = [];
  for(const s of series) for(const v of s.path) allVals.push(Math.max(v,1));
  allVals.sort((a,b)=>a-b);
  const pctl = p => allVals[Math.min(allVals.length-1, Math.floor(allVals.length*p))];
  const padL=72, padB=30, padT=10, padR=10;
  const plotW = w-padL-padR, plotH = h-padT-padB;
  const x = tt => padL + (tt/steps)*plotW;
  let y, logMin, logMax, minV, maxV;
  if(logScale){
    minV = Math.max(1, pctl(0.01)); maxV = Math.max(minV*1.1, pctl(0.99));
    logMin = Math.log(minV); logMax = Math.log(maxV);
    y = v => { const lv=Math.log(Math.max(v,1)); const c=Math.min(logMax,Math.max(logMin,lv)); return padT+plotH-((c-logMin)/(logMax-logMin))*plotH; };
  } else {
    minV = Math.min(0, pctl(0.01)); maxV = pctl(0.99);
    y = v => { const c=Math.min(maxV,Math.max(minV,v)); return padT+plotH-((c-minV)/(maxV-minV))*plotH; };
  }
  for(const s of series){
    ctx.strokeStyle = s.color; ctx.lineWidth = s.width;
    ctx.setLineDash(s.dashed ? [6,4] : []);
    ctx.beginPath();
    for(let ti=0;ti<=steps;ti++){ const px=x(ti), py=y(s.path[ti]); ti===0?ctx.moveTo(px,py):ctx.lineTo(px,py); }
    ctx.stroke();
  }
  ctx.setLineDash([]);
  ctx.strokeStyle = 'rgba(142,160,194,.35)'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(padL,padT); ctx.lineTo(padL,h-padB); ctx.lineTo(w-padR,h-padB); ctx.stroke();
  ctx.fillStyle = 'rgba(142,160,194,.9)'; ctx.font='11px monospace';
  for(let i=0;i<=4;i++){
    const v = logScale ? Math.exp(logMin+(logMax-logMin)*i/4) : minV+(maxV-minV)*i/4;
    ctx.fillText(Math.round(v).toLocaleString(), 4, y(v)+3);
  }
  for(let yr=0;yr<=years;yr+=Math.max(1,Math.round(years/6))){
    ctx.fillText(yr+(LANG==='en'?'y':'a'), x(yr*12)-8, h-padB+16);
  }
  document.getElementById('chartLegend').innerHTML = series.map(s=>`<span><i style="background:${s.color}"></i>${s.label}</span>`).join('');
}
function maxDrawdown1Y(path){
  const span = 12; // rolling 12-month window, in monthly steps
  let worst = 0;
  for(let start=0; start<path.length; start++){
    const end = Math.min(path.length-1, start+span);
    let peak = path[start] || 1;
    for(let j=start; j<=end; j++){
      if(path[j]>peak) peak = path[j];
      const dd = peak>0 ? (path[j]-peak)/peak : 0;
      if(dd<worst) worst = dd;
    }
  }
  return worst*100;
}
function showQuadStats(series, capital, contrib, years){
  const fmt = fmtMoney;
  const invested = capital + contrib*years;
  document.getElementById('qstats').innerHTML = series.map(s=>{
    const final = s.path[s.path.length-1];
    const gain = final - invested;
    const pct = invested>0 ? (gain/invested*100) : 0;
    const dd = maxDrawdown1Y(s.path);
    return `<div class="qstat" style="border-color:${s.color}">
      <b>${fmt(final)}</b><span>${t('statFinal', s.label, fmt(gain))}</span>
      <div class="qstatSub">${t('statReturn', pct.toFixed(1))} · ${t('statDrawdown', dd.toFixed(1))}</div>
    </div>`;
  }).join('');
}
