function renderPie(items){
  let acc=0; const stops = items.map(([label,pct,color])=>{ const start=acc; acc+=pct; return `${color} ${start}% ${acc}%`; }).join(', ');
  return `background:conic-gradient(${stops});`;
}
function renderHistoricPies(){
  document.getElementById('historicPies').innerHTML = HISTORIC_PORTFOLIOS.map(p=>`
    <div class="pieCard">
      <div class="pie" style="${renderPie(p.items)}"></div>
      <div style="font-weight:600;font-size:.9rem;margin-bottom:.4rem;">${p.name}</div>
      <div class="pieLegend">${p.items.map(([label,pct,color])=>{
        const lbl = LANG==='en' ? label.split('/')[0] : (label.split('/')[1]||label.split('/')[0]);
        return `<div><span><i style="background:${color}"></i>${lbl}</span><span>${pct}%</span></div>`;
      }).join('')}</div>
    </div>`).join('');
}
