<!DOCTYPE html>
<html lang="fr" style="visibility:hidden">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Eiko Finance — Simulation Monte Carlo de portefeuille</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<style>
:root{
  /* Eiko Finance — brand palette: navy & gold */
  --bg:#0a1a3d; --panel:#122750; --panel2:#1a3468; --line:#2a4785;
  --text:#ffffff; --muted:#9db0d6; --accent:#1e5cc8; --accent2:#e8c46a;
  --danger:#ff453a; --font:-apple-system,BlinkMacSystemFont,'SF Pro Text','SF Pro Display','Helvetica Neue',Helvetica,Arial,sans-serif; --mono:'SF Mono',ui-monospace,Menlo,Consolas,monospace;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: light){
  :root:not([data-theme="dark"]){ --bg:#f4f6fb; --panel:#ffffff; --panel2:#eef2fa; --line:#ccd6ea; --text:#0a1a3d; --muted:#5d6f95; }
}
:root[data-theme="light"]{ --bg:#f4f6fb; --panel:#ffffff; --panel2:#eef2fa; --line:#ccd6ea; --text:#0a1a3d; --muted:#5d6f95; }
*{box-sizing:border-box;}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);min-height:100%;overflow-x:hidden;}
header{padding:2.2rem 1.5rem 1rem;max-width:1000px;margin:0 auto;}
h1{font-size:1.9rem;font-weight:600;margin:0 0 .3rem;letter-spacing:.01em;}
.sub{color:var(--muted);font-size:.98rem;max-width:60ch;line-height:1.5;}
main{max-width:1000px;margin:0 auto;padding:0 1.5rem 3rem;}
.tabs{display:flex;gap:.5rem;margin-bottom:1.2rem;flex-wrap:wrap;}
.tabSelect{display:none;}
@media (max-width: 640px){
  .tabs{display:none;}
  .tabSelect{display:block;width:100%;margin-bottom:1.2rem;font-size:.9rem;padding:.6rem .7rem;}
}
.tabBtn{font-family:var(--font);font-size:.85rem;border-radius:20px;padding:.55rem .9rem;border:none;background:var(--panel2);color:var(--muted);cursor:pointer;}
.tabBtn.active{background:var(--accent);color:#fff;font-weight:600;}
.tabPanel{display:none;}
.tabPanel.active{display:block;}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:1.3rem;margin-bottom:1.2rem;}
.panel h2{font-size:1.05rem;margin:0 0 .9rem;font-weight:600;}
.panel h3{font-size:.92rem;margin:1rem 0 .5rem;font-weight:600;color:var(--muted);}
table{width:100%;border-collapse:collapse;font-size:.9rem;}
th{text-align:left;color:var(--muted);font-weight:500;font-size:.76rem;padding:.3rem .5rem;}
td{padding:.25rem .5rem;}
input,select{width:100%;background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:10px;padding:.4rem .5rem;font-family:var(--mono);font-size:.86rem;}
input[data-f="weight"],input[data-f="ret"],input[data-f="vol"]{text-align:center;}
input.wtInput{min-width:4em;}
input[data-f="name"]{min-width:12em;}
.stickyCol{position:sticky;left:0;background:var(--panel);z-index:5;box-shadow:2px 0 4px rgba(0,0,0,.15);}
thead .stickyCol{z-index:6;background:var(--panel);}
input[data-f="isin"]{min-width:9em;}
input[data-f="issuer"]{min-width:10em;}
select[data-f="geo"]{min-width:9em;}
select[data-f="cat"]{min-width:11em;font-size:.8rem;}
input:focus,select:focus{outline:2px solid var(--accent);outline-offset:1px;}
.row-actions{display:flex;gap:.6rem;margin-top:.7rem;flex-wrap:wrap;align-items:center;}
button{font-family:var(--font);font-size:.9rem;border-radius:10px;padding:.55rem 1rem;border:none;background:var(--panel2);color:var(--text);cursor:pointer;}
button:hover{border-color:var(--accent);}
button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600;}
button.primary:hover{filter:brightness(1.08);}
.params{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.9rem;}
.field label{display:block;font-size:.78rem;color:var(--muted);margin-bottom:.3rem;}
.weightwarn{font-size:.82rem;color:var(--accent2);margin-top:.3rem;min-height:1.2em;width:100%;}
canvas{width:100%;height:360px;display:block;}
.legend{display:flex;flex-direction:column;gap:.45rem;font-size:.82rem;color:var(--muted);margin-top:.8rem;}
.legend span{display:flex;align-items:flex-start;}
.legend i{flex-shrink:0;display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:.55rem;margin-top:.22rem;}
.qstats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem;margin-top:1rem;}
.qstat{border-left:3px solid var(--line);padding:.3rem .7rem;}
.qstat b{display:block;font-family:var(--mono);font-size:1.05rem;}
.qstat span{color:var(--muted);font-size:.76rem;}
.qstatSub{color:var(--muted);font-size:.72rem;margin-top:.3rem;font-family:var(--mono);}
#stratTable{table-layout:fixed;}
#stratTable th:nth-child(1),#stratTable td:nth-child(1){width:30%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
#stratTable th:nth-child(2),#stratTable td:nth-child(2){width:18%;}
#stratTable th:nth-child(3),#stratTable td:nth-child(3){width:16%;text-align:center;}
#stratTable th:nth-child(4),#stratTable td:nth-child(4){width:16%;}
#stratTable th:nth-child(5),#stratTable td:nth-child(5){width:20%;text-align:center;font-size:.8rem;}
.advice ul{margin:.4rem 0 1rem;padding-left:1.2rem;line-height:1.55;}
.advice li{margin-bottom:.5rem;}
.catrow{display:flex;justify-content:space-between;font-size:.88rem;padding:.3rem 0;border-bottom:1px solid var(--line);}
.q-block{padding:.7rem 0;border-bottom:1px solid var(--line);}
.q-block p{margin:0 0 .4rem;font-size:.88rem;}
.q-opts label{display:flex;align-items:center;gap:.55rem;font-size:.82rem;padding:.4rem 0;cursor:pointer;line-height:1.3;}
.q-opts input[type="radio"]{flex-shrink:0;width:16px;height:16px;margin:0;accent-color:var(--accent);}
.profile-result{padding:1rem;margin-top:1rem;background:var(--panel2);border-radius:14px;}
.profileOwnerBlock.active{border-color:var(--accent)!important;background:var(--panel2);box-shadow:inset 3px 0 var(--accent);}
.segBtns{display:flex;gap:.5rem;flex-wrap:wrap;}
#assetTable.simple-mode .expert-only{display:none;}
#assetTable.simple-mode .expert-only-inline{display:none;}
.tutOverlay{position:fixed;inset:0;z-index:1000;pointer-events:none;}
.tutScrim{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.4);opacity:0;pointer-events:none;transition:opacity .15s;}
.tutScrim.on{opacity:1;pointer-events:auto;}
.tutBox{position:fixed;left:0;right:0;bottom:0;z-index:1001;margin:0 auto;max-width:480px;width:100%;background:var(--panel);border:1px solid var(--line);border-bottom:none;border-radius:18px 18px 0 0;padding:1.3rem 1.3rem calc(1.2rem + env(safe-area-inset-bottom,0px));box-shadow:0 -8px 28px rgba(0,0,0,.35);pointer-events:auto;max-height:45vh;overflow-y:auto;}
.tutBox h3{margin:0 0 .5rem;font-size:1.05rem;}
.tutBox p{color:var(--muted);font-size:.86rem;line-height:1.5;margin:0 0 1rem;}
.tutDots{display:flex;gap:.4rem;justify-content:center;margin-bottom:1rem;}
.tutDots span{width:6px;height:6px;border-radius:50%;background:var(--line);}
.tutDots span.active{background:var(--accent);}
.tutCoachTarget{position:relative;outline:3px solid var(--accent);outline-offset:3px;border-radius:10px;}
.tutActions{display:flex;justify-content:space-between;align-items:center;gap:.6rem;}
.segBtn{border-radius:20px;padding:.5rem .9rem;border:none;background:var(--panel2);color:var(--muted);cursor:pointer;font-family:var(--font);}
.segBtn.active{background:var(--accent);color:#fff;font-weight:600;}
.pieGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.4rem;margin-top:1rem;}
.pieCard{text-align:center;}
.pie{width:140px;height:140px;border-radius:50%;margin:0 auto .8rem;}
.pieLegend{font-size:.76rem;color:var(--muted);text-align:left;display:inline-block;}
.pieLegend div{display:flex;justify-content:space-between;gap:.6rem;padding:.1rem 0;}
.pieLegend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:.4rem;}
.investorRow,.etfRow,.dkRow{display:flex;justify-content:space-between;align-items:center;gap:.6rem;padding:.5rem 0;border-bottom:1px solid var(--line);flex-wrap:wrap;}
.investorRow a{color:var(--accent);text-decoration:none;font-size:.82rem;}
.investorRow a:hover{text-decoration:underline;}
.etfName{font-size:.85rem;}
.etfMeta{font-size:.74rem;color:var(--muted);}
.etfIsin{font-family:var(--mono);font-size:.78rem;background:var(--panel2);padding:.15rem .5rem;border-radius:5px;}
.peaTag{font-size:.68rem;padding:.1rem .4rem;border-radius:4px;margin-left:.4rem;}
.peaYes{background:rgba(63,185,138,.2);color:var(--accent);}
.peaNo{background:rgba(226,102,74,.18);color:var(--danger);}
.etfActions{display:flex;gap:.4rem;}
.etfActions button{font-size:.76rem;padding:.35rem .6rem;}
.issuerGroup{margin-top:1rem;}
.dkRow{font-size:.85rem;}
.dkTicker{font-family:var(--mono);background:var(--panel2);padding:.1rem .4rem;border-radius:4px;font-size:.78rem;}

/* ================= Eiko Finance — brand & splash ================= */
/* keeps any wide content (the asset table) from widening the layout on phones */
@media (max-width:600px){
  h1{font-size:1.3rem;}
  .sub{font-size:.9rem;}
}
.brandRow{display:flex;align-items:center;gap:.75rem;margin-bottom:.9rem;}
.brandLogo{height:54px;width:auto;flex-shrink:0;display:block;}
.brandName{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--text);white-space:nowrap;}
@media (max-width:600px){
  .brandLogo{height:44px;}
  .brandName{font-size:11px;letter-spacing:.1em;}
}
@media (max-width:400px){ .brandName{display:none;} }
#eikoSplash{position:fixed;inset:0;z-index:2000;display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:#ffffff;visibility:visible;transition:opacity .55s ease;opacity:1;padding:2rem;}
#eikoSplash.on{opacity:0;}
#eikoSplash .spLogo{width:min(58vw,300px);max-height:58vh;height:auto;display:block;
  animation:eikoLogoIn .8s cubic-bezier(.22,.75,.3,1) both;}
@keyframes eikoLogoIn{from{opacity:0;transform:translateY(14px) scale(.95);}to{opacity:1;transform:none;}}
@media (prefers-reduced-motion:reduce){
  #eikoSplash .spLogo{animation:none;}
}
footer{max-width:1000px;margin:0 auto;padding:0 1.5rem 2rem;color:var(--muted);font-size:.8rem;line-height:1.5;}
</style>
</head>
<body>
<div id="eikoSplash" role="presentation" aria-hidden="true">
  <img class="spLogo" id="eikoSplashLogo" alt="Eiko Finance">
</div>
<script>
(function(){
  // The brand mark is painted with the page: <html> is hidden by an inline
  // style until the app script reveals it, and the splash overrides that with
  // visibility:visible, so nothing but the logo is on screen at first paint.
  var img = document.getElementById('eikoSplashLogo');
  if(img) img.src = 'data:image/png;base64,';
})();
</script>
<header>
  <div class="brandRow"><img class="brandLogo" id="eikoHeaderLogo" alt="Eiko Finance"><span class="brandName">Eiko Finance</span></div>
  <h1 data-i18n="appTitle">Simulation Monte Carlo de portefeuille</h1>
  <div class="sub" data-i18n="appSub">Pondération, simulation par scénario macro, stratégie de rééquilibrage, profil investisseur et ressources.</div>
</header>
<main>
  <div class="tabs">
    <button class="tabBtn active" data-tab="t1">Allocation</button>
    <button class="tabBtn" data-tab="t2">Simulation</button>
    <button class="tabBtn" data-tab="t3">Pistes d'équilibrage</button>
    <button class="tabBtn" data-tab="t4">Stratégie & DCA</button>
    <button class="tabBtn" data-tab="t6">Ressources</button>
    <button class="tabBtn" data-tab="t8" data-i18n="t8">Notes personnelles</button>
    <button class="tabBtn" data-tab="t7">Profil & Réglages</button>
  </div>
  <select class="tabSelect" id="tabSelect">
    <option value="t1">Allocation</option>
    <option value="t2">Simulation</option>
    <option value="t3">Pistes d'équilibrage</option>
    <option value="t4">Stratégie & DCA</option>
    <option value="t6">Ressources</option>
    <option value="t8">Notes personnelles</option>
    <option value="t7">Profil & Réglages</option>
  </select>

  <section id="t1" class="tabPanel active">
    <div class="panel">
      <h2 data-i18n="t1Title">Composition du portefeuille</h2>
      <div class="pieGrid" id="assetProfileBlocks" style="margin:0 0 1rem;"></div>
      <div style="overflow-x:auto;">
      <table id="assetTable">
        <thead><tr>
          <th class="stickyCol" data-i18n="colAsset">Actif</th><th data-i18n="colOwner">Profil</th><th class="expert-only" data-i18n="colIssuer">Émetteur</th><th class="expert-only">ISIN</th><th class="expert-only" data-i18n="colTicker">Ticker</th><th class="expert-only" data-i18n="colCat">Catégorie</th><th class="expert-only" data-i18n="colGeo">Géographie</th>
          <th class="expert-only" data-i18n="colUnits">Unités</th><th data-i18n="colPrice">Cours</th><th class="expert-only" data-i18n="colCostPrice">Prix d'achat</th><th class="expert-only" data-i18n="colAmount">Investi</th><th class="expert-only" data-i18n="colCurValue">Valeur actuelle</th>
          <th data-i18n="colWeight">Poids (%)</th><th class="expert-only" data-i18n="colRet">Rendement attendu (%)</th>
          <th class="expert-only" data-i18n="colVol">Volatilité (%)</th><th class="expert-only"></th><th class="expert-only"></th>
        </tr></thead>
        <tbody></tbody>
      </table>
      </div>
      <div class="row-actions">
        <button id="addAsset" data-i18n="btnAdd">+ Ajouter un actif</button>
        <button id="sortAssets"></button>
        <button id="fetchAllBtn" data-i18n="btnFetchAll">📡 Tout actualiser</button>
        <button id="modeToggle"></button>
        <button id="saveportfolioBtn" class="primary" data-i18n="btnSavePortfolio">💾 Sauvegarder</button>
        <span class="weightwarn" id="weightWarn"></span>
      </div>
      <pre id="liveMsg" style="display:none;white-space:pre-wrap;background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:.7rem;font-size:.76rem;margin-top:.6rem;max-height:260px;overflow:auto;"></pre>
      <p style="color:var(--muted);font-size:.78rem;margin-top:.6rem;" data-i18n="unitsPriceNote">Renseignez les unités et le cours d'un actif pour calculer automatiquement son montant investi et son poids (%) — le champ Poids se verrouille alors et se recalcule tout seul. Laissez ces deux champs vides pour continuer à saisir le poids manuellement.</p>
    </div>
    <div class="panel">
      <h2 data-i18n="t7CompositionTitle">Composition actuelle</h2>
      <div class="segBtns" id="pieOwnerGroup" style="margin-bottom:.6rem;"></div>
      <div class="segBtns compPieGroup">
        <button data-pie-mode="asset" class="segBtn active" data-i18n="pieByAsset">Par actif</button>
        <button data-pie-mode="cat" class="segBtn" data-i18n="pieByCat">Par catégorie</button>
        <button data-pie-mode="geo" class="segBtn" data-i18n="pieByGeo">Par géographie</button>
      </div>
      <div class="pieGrid" id="t1CompPie"></div>
    </div>
  </section>

  <section id="t2" class="tabPanel">
    <div class="panel">
      <h2 data-i18n="t2Title">Paramètres de simulation</h2>
      <div class="params">
        <div class="field"><label data-i18n="lblCapital">Capital initial (€)</label><input id="capital" type="number" value="10000" min="0"></div>
        <div class="field"><label data-i18n="lblYears">Horizon (années)</label><input id="years" type="number" value="10" min="1" max="60"></div>
        <div class="field"><label data-i18n="lblContrib">Versement annuel (€)</label><input id="contrib" type="number" value="0" min="0"></div>
        <div class="field"><label data-i18n="lblNsim">Simulations par scénario</label><input id="nsim" type="number" value="300" min="50" max="1000"></div>
      </div>
      <div class="field" style="margin-top:.9rem;max-width:22rem;">
        <label data-i18n="simProfileLabel">Allocation à simuler</label>
        <select id="simProfileMode"><option value="portfolio" data-i18n="simCurrentPortfolio">Portefeuille actuel</option></select>
      </div>
      <div id="combinedProfileControls" class="params" style="display:none;margin-top:.7rem;">
        <div class="field"><label id="combinedProfile1Label" data-i18n="profile1Monthly">Versement mensuel du profil 1 (€)</label><input id="profile1Contribution" type="number" value="0" min="0"></div>
        <div class="field"><label id="combinedProfile2Label" data-i18n="profile2Monthly">Versement mensuel du profil 2 (€)</label><input id="profile2Contribution" type="number" value="0" min="0"></div>
      </div>
      <p id="combinedProfileHelp" data-i18n="combinedProfileHelp" style="display:none;color:var(--muted);font-size:.78rem;margin:.5rem 0 0;">Les versements mensuels définissent la part de chaque profil dans l’allocation commune.</p>
      <p id="simProfileNotice" style="display:none;color:var(--muted);font-size:.78rem;margin:.5rem 0 0;"></p>
      <div class="row-actions">
        <button id="scaleToggle"></button>
        <button class="primary" id="run" data-i18n="btnRun">Lancer la simulation</button>
        <button id="saveSimBtn" style="display:none;" data-i18n="btnSaveSim">💾 Sauvegarder</button>
        <button id="newSimBtn" style="display:none;" data-i18n="btnNewSim">➕ Nouvelle simulation</button>
      </div>
    </div>
    <section class="panel" id="resultsPanel" style="display:none;">
      <h2 data-i18n="t2ResultsTitle">Réaction du portefeuille selon 4 scénarios macro</h2>
      <canvas id="chart"></canvas>
      <div class="legend" id="chartLegend"></div>
      <div class="qstats" id="qstats"></div>
    </section>
  </section>

  <section id="t3" class="tabPanel">
    <div class="panel advice">
      <h2 data-i18n="t3Title">Pistes pour équilibrer / limiter la volatilité</h2>
      <div class="segBtns" id="adviceGoalBtns">
        <button class="segBtn active" data-goal="profile" data-i18n="goalProfile">Selon mon profil</button>
        <button class="segBtn" data-goal="performance" data-i18n="goalPerformance">Plus de performance</button>
        <button class="segBtn" data-goal="security" data-i18n="goalSecurity">Plus de sécurité</button>
      </div>
      <div id="adviceContent" style="margin-top:.8rem;"></div>
      <div class="row-actions">
        <button id="refreshAdvice" data-i18n="btnRefreshAdvice">↻ Actualiser à partir de la pondération actuelle</button>
        <button id="saveAdviceBtn" data-i18n="btnSaveAdvice">💾 Sauvegarder</button>
      </div>
    </div>
  </section>

  <section id="t4" class="tabPanel">
    <div class="panel">
      <h2 data-i18n="t4Title">Stratégie cible & plan de DCA</h2>
      <div class="params">
        <div class="field"><label data-i18n="lblStratValue">Valeur totale actuelle du portefeuille (€)</label><input id="stratValue" type="number" value="10000" min="0"></div>
        <div class="field"><label data-i18n="lblDcaAmount">Montant du DCA (€)</label><input id="dcaAmount" type="number" value="300" min="0"></div>
        <div class="field"><label data-i18n="lblDcaFreq">Fréquence</label><select id="dcaFreq"><option value="mensuel" data-i18n="freqM">Mensuel</option><option value="bimestriel" data-i18n="freqB">Bimestriel</option><option value="trimestriel" data-i18n="freqT">Trimestriel</option></select></div>
        <div class="field"><label data-i18n="lblRebalFreq">Fréquence de rééquilibrage complet</label><select id="rebalFreq"><option value="12" data-i18n="rebal1">Annuel</option><option value="24" data-i18n="rebal2">Tous les 2 ans</option><option value="36" data-i18n="rebal3">Tous les 3 ans</option><option value="60" data-i18n="rebal5">Tous les 5 ans</option></select></div>
      </div>
      <div style="overflow-x:auto;margin-top:1rem;">
      <table id="stratTable"><thead><tr>
        <th data-i18n="colAsset">Actif</th><th data-i18n="colCat">Catégorie</th><th data-i18n="colCurWeight">Poids actuel</th>
        <th data-i18n="colTargetWeight">Poids cible (%)</th><th data-i18n="colGap">Écart</th>
      </tr></thead>
      <tbody id="stratBody"></tbody></table>
      </div>
      <div class="row-actions"><button class="primary" id="calcStrat" data-i18n="btnCalcStrat">Calculer le plan de rééquilibrage</button></div>
      <div id="stratResult" style="margin-top:1rem;"></div>
      <div class="pieGrid" id="stratPies" style="margin-top:1rem;"></div>
      <div class="row-actions" style="margin-top:1.4rem;border-top:1px solid var(--line);padding-top:1rem;">
        <label style="font-size:.78rem;color:var(--muted);" data-i18n="lblProjHorizon">Horizon de projection</label>
        <select id="projHorizon" style="max-width:14em;">
          <option value="year_end" data-i18n="projYearEnd">31 déc. de cette année</option>
          <option value="1y" data-i18n="proj1y">Dans 1 an</option>
          <option value="2y" data-i18n="proj2y">Dans 2 ans</option>
          <option value="5y" data-i18n="proj5y">Dans 5 ans</option>
        </select>
        <button id="runProjection" data-i18n="btnProject">Projeter le portefeuille</button>
      </div>
      <div id="projTable" style="margin-top:1rem;"></div>
    </div>
