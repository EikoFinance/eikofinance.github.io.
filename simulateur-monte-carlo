function addAssetRow(name, isin, weight, ret, vol, cat, units, price, ticker, issuer, geo, costPrice, ownerId){
  cat = cat || 'actions';
  geo = geo || 'global';
  ownerId = ownerId || loadSavedProfiles()[0]?.id || 'profile-1';
  if(!units && !ticker && SAVED_UNITS[name]){ units = SAVED_UNITS[name].units; ticker = SAVED_UNITS[name].ticker; }
  const tr = document.createElement('tr');
  tr.innerHTML = `<td class="stickyCol" style="position:sticky;left:0;"><input value="${name}" data-f="name" autocomplete="off"></td>
    <td><select data-f="owner">${profileOwnerOptions(ownerId)}</select></td>
    <td class="expert-only"><input value="${issuer||''}" data-f="issuer" placeholder="Amundi, iShares…" style="font-size:.78rem;"></td>
    <td class="expert-only"><input value="${isin||''}" data-f="isin" placeholder="FR0000120271" style="font-size:.78rem;"></td>
    <td class="expert-only"><input data-f="ticker" value="${ticker||''}" placeholder="AAPL / BTC" style="font-size:.78rem;"></td>
    <td class="expert-only"><select data-f="cat">${catOptions(cat)}</select></td>
    <td class="expert-only"><select data-f="geo">${geoOptions(geo)}</select></td>
    <td class="expert-only"><input class="wtInput" type="text" inputmode="decimal" value="${units||''}" data-f="units" placeholder="0"></td>
    <td><input class="wtInput" type="text" inputmode="decimal" value="${price||''}" data-f="price" placeholder="0"></td>
    <td class="expert-only"><input class="wtInput" type="text" inputmode="decimal" value="${costPrice||''}" data-f="costprice" placeholder="0"></td>
    <td class="amountCell expert-only" style="text-align:center;color:var(--muted);font-size:.82rem;">—</td>
    <td class="curValueCell expert-only" style="text-align:center;color:var(--muted);font-size:.82rem;">—</td>
    <td><input class="wtInput" type="text" inputmode="decimal" value="${weight}" data-f="weight"></td>
    <td class="expert-only"><input type="text" inputmode="decimal" value="${ret}" data-f="ret"></td>
    <td class="expert-only"><input type="text" inputmode="decimal" value="${vol}" data-f="vol"></td>
    <td class="expert-only"><button data-est title="${t('btnEstimateTitle')}" style="font-size:.76rem;">${t('btnEstimate')}</button></td>
    <td><button data-del>${t('btnDelete')}</button></td>`;
  tr.querySelector('[data-est]').onclick = () => estimateRow(tr);

  const isinInput = tr.querySelector('[data-f="isin"]');
  const tickerInput = tr.querySelector('[data-f="ticker"]');
  const issuerInput = tr.querySelector('[data-f="issuer"]');
  const nameInput = tr.querySelector('[data-f="name"]');
  function applyDbMatch(entry){
    if(!entry) return;
    if(entry.ticker) tickerInput.value = entry.ticker;
    if(entry.isin) isinInput.value = entry.isin;
    issuerInput.value = entry.issuer;
    if(!nameInput.value.trim()) nameInput.value = entry.name;
  }
  isinInput.addEventListener('change', () => applyDbMatch(ASSET_DB_BY_ISIN[isinInput.value.trim().toUpperCase()]));
  tickerInput.addEventListener('change', () => applyDbMatch(ASSET_DB_BY_TICKER[tickerInput.value.trim().toUpperCase()]));
  tr.querySelector('[data-del]').onclick = () => { tr.remove(); checkWeights(); };
  tr.querySelectorAll('input,select').forEach(i => { i.oninput = checkWeights; i.onchange = () => { checkWeights(); if(i.dataset.f==='owner') applyAssetOwnerFilter(); }; });
  tbody.appendChild(tr);
  checkWeights();
}
const PIE_PALETTE = ['#3fb98a','#e2b13c','#8f7bff','#4aa8e0','#ff9f5a','#e2493a','#2e8b6f','#c77dff','#5bd1d7','#f2b5d4'];
let CURRENCY = 'EUR';
let FX_RATE = 1.16; // 1 EUR = X USD — manually set, see note in Profil & Réglages
function fmtMoney(amountEur){
  const locale = LANG==='en' ? 'en-US' : 'fr-FR';
  if(CURRENCY==='USD') return '$'+Math.round(amountEur*FX_RATE).toLocaleString(locale);
  return Math.round(amountEur).toLocaleString(locale)+' €';
}
const CAT_COLORS = {crypto:'#ff9f5a',actions:'#0a84ff',metaux:'#ffd60a',matieres:'#8f7bff',obligations:'#30d158'};
const GEO_COLORS = {global:'#8f7bff',us:'#0a84ff',europe:'#30d158',asia_pacific:'#ff9f0a',other:'#8ea0c2'};
let pieGroupMode = 'asset'; // 'asset' | 'cat' | 'geo'
let chartOwnerFilter = 'combined';
function pieCardHtml(items, title){
  return `<div class="pieCard">
    ${title ? `<div style="font-weight:600;font-size:.85rem;margin-bottom:.5rem;">${title}</div>` : ''}
    <div class="pie" style="${renderPie(items)}"></div>
    <div class="pieLegend">${items.filter(it=>it[1]>0.3).map(([label,pct,color])=>`<div><span><i style="background:${color}"></i>${label}</span><span>${pct.toFixed(1)}%</span></div>`).join('')}</div>
  </div>`;
}
function applyAssetOwnerFilter(){
  tbody.querySelectorAll('tr').forEach(tr=>{
    const owner = tr.querySelector('[data-f="owner"]')?.value;
    tr.style.display = assetOwnerFilter==='all' || owner===assetOwnerFilter ? '' : 'none';
  });
  document.querySelectorAll('[data-owner-filter]').forEach(button=>button.classList.toggle('active',button.dataset.ownerFilter===assetOwnerFilter));
}
function setAssetOwnerFilter(ownerId){
  assetOwnerFilter=ownerId;
  applyAssetOwnerFilter();
}
function renderAssetProfileBlocks(){
  const container=document.getElementById('assetProfileBlocks');
  if(!container) return;
  const profiles=loadSavedProfiles();
  const owners=profiles.length ? profiles : [{id:'profile-1',name:t('profileDefault1')}];
  const assets=getAssets();
  const total=assets.reduce((sum,asset)=>sum+asset.weight,0)||1;
  const block=(id,name,owned)=>`<button type="button" data-owner-filter="${escapeHtml(id)}" class="profileOwnerBlock ${assetOwnerFilter===id?'active':''}" style="width:100%;text-align:left;min-height:4.5rem;border:1px solid var(--line);border-radius:8px;padding:.7rem;">
    <strong>${escapeHtml(name)}</strong><br><span style="font-size:.78rem;color:var(--muted);">${t('profileOwnedAssets',owned.length)} · ${t('profileShare',(owned.reduce((sum,asset)=>sum+asset.weight,0)/total*100).toFixed(1))}</span></button>`;
  container.innerHTML=block('all',t('profileAllAssets'),assets)+owners.map(profile=>block(profile.id,profile.name||t('profileDefault1'),assets.filter(asset=>asset.ownerId===profile.id))).join('');
  container.querySelectorAll('[data-owner-filter]').forEach(button=>button.onclick=()=>setAssetOwnerFilter(button.dataset.ownerFilter));
  applyAssetOwnerFilter();
}
function renderProfileChartControls(){
  const group=document.getElementById('pieOwnerGroup');
  if(!group) return;
  const profiles=loadSavedProfiles();
  const owners=profiles.length ? profiles : [{id:'profile-1',name:t('profileDefault1')}];
  const options=[...owners.map(profile=>({id:profile.id,name:profile.name||t('profileDefault1')})),{id:'combined',name:t('profileCommonLabel')}];
  if(!options.some(option=>option.id===chartOwnerFilter)) chartOwnerFilter='combined';
  group.innerHTML=options.map(option=>`<button type="button" class="segBtn ${option.id===chartOwnerFilter?'active':''}" data-chart-owner="${escapeHtml(option.id)}">${escapeHtml(option.name)}</button>`).join('');
  group.querySelectorAll('[data-chart-owner]').forEach(button=>button.onclick=()=>{chartOwnerFilter=button.dataset.chartOwner;renderCompositionPies();});
}
function renderCompositionPies(){
  renderProfileChartControls();
  const allAssets = getAssets().filter(a=>a.weight>0);
  const assets = chartOwnerFilter==='combined' ? allAssets : allAssets.filter(asset=>asset.ownerId===chartOwnerFilter);
  const totalW = assets.reduce((s,a)=>s+a.weight,0)||1;
  let html;
  if(pieGroupMode==='cat'){
    const byCat = {};
    assets.forEach(a=> byCat[a.cat] = (byCat[a.cat]||0) + a.weight/totalW*100);
    const mainItems = Object.entries(byCat).map(([k,pct])=>[catLabel(k), pct, CAT_COLORS[k]||'#8ea0c2']);
    html = mainItems.length ? pieCardHtml(mainItems) : '';
    // One breakdown pie per category, ordered by category weight — largest first
    const catOrder = Object.entries(byCat).sort((a,b)=>b[1]-a[1]).map(([k])=>k);
    catOrder.forEach(k=>{
      const catAssets = assets.filter(a=>a.cat===k);
      if(catAssets.length < 1) return;
      const catTotal = catAssets.reduce((s,a)=>s+a.weight,0);
      const subItems = catAssets.map((a,i)=>[a.name, a.weight/catTotal*100, PIE_PALETTE[i%PIE_PALETTE.length]]);
      html += pieCardHtml(subItems, catLabel(k));
    });
  } else if(pieGroupMode==='geo'){
    const byGeo = {};
    assets.forEach(a=> byGeo[a.geo] = (byGeo[a.geo]||0) + a.weight/totalW*100);
    const mainItems = Object.entries(byGeo).map(([k,pct])=>[geoLabel(k), pct, GEO_COLORS[k]||'#8ea0c2']);
    html = mainItems.length ? pieCardHtml(mainItems) : '';
    const geoOrder = Object.entries(byGeo).sort((a,b)=>b[1]-a[1]).map(([k])=>k);
    geoOrder.forEach(k=>{
      const geoAssets = assets.filter(a=>a.geo===k);
      if(geoAssets.length < 1) return;
      const geoTotal = geoAssets.reduce((s,a)=>s+a.weight,0);
      const subItems = geoAssets.map((a,i)=>[a.name, a.weight/geoTotal*100, PIE_PALETTE[i%PIE_PALETTE.length]]);
      html += pieCardHtml(subItems, geoLabel(k));
    });
  } else {
    const items = assets.map((a,i)=>[a.name, a.weight/totalW*100, PIE_PALETTE[i%PIE_PALETTE.length]]);
    html = items.length ? pieCardHtml(items) : '';
  }
  document.querySelectorAll('.compPieGroup').forEach(g=>{
    g.querySelectorAll('[data-pie-mode]').forEach(b=> b.classList.toggle('active', b.dataset.pieMode===pieGroupMode));
  });
  const t1 = document.getElementById('t1CompPie'); if(t1) t1.innerHTML = html;
}
function setPieGroupMode(mode){ pieGroupMode = mode; renderCompositionPies(); }
function num(v){ return parseFloat((v||'').toString().replace(',','.'))||0; }
function checkWeights(){
  saveUnitsMap();
  savePortfolio();
  const rows = [...tbody.querySelectorAll('tr')];
  const unitsArr = rows.map(tr => num(tr.querySelector('[data-f="units"]').value));
  const priceArr = rows.map(tr => num(tr.querySelector('[data-f="price"]').value));
  const costArr = rows.map((tr,i) => { const c = num(tr.querySelector('[data-f="costprice"]').value); return c>0 ? c : priceArr[i]; });
  const amounts = unitsArr.map((u,i)=> u*priceArr[i]); // current value — drives weight
  const invested = unitsArr.map((u,i)=> u*costArr[i]); // cost basis
  const totalAmount = amounts.reduce((s,a)=>s+a,0);
  const amountMode = totalAmount > 0;
  const sym = CURRENCY==='USD' ? ' $' : ' €';
  const locale = LANG==='en' ? 'en-US' : 'fr-FR';
  rows.forEach((tr,i)=>{
    tr.querySelector('.amountCell').textContent = invested[i]>0 ? Math.round(invested[i]).toLocaleString(locale)+sym : '—';
    const cv = tr.querySelector('.curValueCell');
    if(cv){
      const gain = amounts[i]-invested[i];
      const gainTxt = (invested[i]>0 && Math.abs(gain)>0.5) ? ` (${gain>=0?'+':''}${Math.round(gain).toLocaleString(locale)})` : '';
      cv.textContent = amounts[i]>0 ? Math.round(amounts[i]).toLocaleString(locale)+sym+gainTxt : '—';
      cv.style.color = gain>0 ? 'var(--accent)' : (gain<0 ? 'var(--danger)' : 'var(--muted)');
    }
    const weightInput = tr.querySelector('[data-f="weight"]');
