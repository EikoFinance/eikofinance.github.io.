function applySavedProfile(profile){
  const alloc = profileAllocation(profile);
  const assets = getAssets().filter(asset=>asset.weight>0);
  const categoryTotals = {}; for(const key in CATS) categoryTotals[key]=0;
  assets.forEach(asset=> categoryTotals[asset.cat] += asset.weight);
  const unassigned = [];
  for(const key in alloc){ if(categoryTotals[key]===0 && alloc[key]>0) unassigned.push(`${catLabel(key)} (${alloc[key]}%)`); }
  assets.forEach(asset=>{
    const share = categoryTotals[asset.cat]>0 ? asset.weight/categoryTotals[asset.cat] : 0;
    assetTargets[asset.name] = (alloc[asset.cat]*share).toFixed(1);
  });
  switchTab('t4');
  calcStrategy();
  if(unassigned.length) document.getElementById('stratResult').insertAdjacentHTML('afterbegin',
    `<p style="color:var(--accent2);font-size:.85rem;">${t('unassigned',unassigned.join(', '))}</p>`);
}
function renderSavedProfileBanner(){
  const el = document.getElementById('savedProfileBanner');
  const profiles = loadSavedProfiles();
  const active = getActiveProfile(profiles);
  const field = document.getElementById('profileNameField');
  const nameInput = document.getElementById('profileNameInput');
  const showQuiz = creatingNewProfile || !!editingProfileId || profiles.length===0;
  setQuizVisible(showQuiz);
  field.style.display = showQuiz ? 'block' : 'none';
  if(showQuiz && !nameInput.value) nameInput.value = t(profiles.length ? 'profileDefault2' : 'profileDefault1');
  document.getElementById('profileManagerActions').style.display = profiles.length ? 'flex' : 'none';
  document.getElementById('addProfileBtn').style.display = profiles.length<2 ? 'inline-block' : 'none';
  el.innerHTML = profiles.map((profile,index)=>{
    const date = new Date(profile.ts).toLocaleDateString(LANG==='en'?'en-GB':'fr-FR');
    return `<div class="profile-result" style="margin-bottom:.8rem;">
      <div class="field"><label for="profileRename${index}">${t('profileNameLabel')}</label><input id="profileRename${index}" type="text" maxlength="40" value="${escapeHtml(profile.name||t(index?'profileDefault2':'profileDefault1'))}"></div>
      <p style="margin:.6rem 0;">${t('profileResultTitle',t('profBand'+profile.bandIdx),profile.score,117)} · ${date}</p>
      <div class="row-actions">
        ${active?.id===profile.id?`<span>${t('profileActive')}</span>`:`<button data-profile-action="active" data-profile-index="${index}">${t('profileSetActive')}</button>`}
        <button data-profile-action="apply" data-profile-index="${index}">${t('btnApplyProfile')}</button>
        <button data-profile-action="rename" data-profile-index="${index}">${t('btnRenameProfile')}</button>
        <button data-profile-action="retake" data-profile-index="${index}">${t('btnRetakeProfile')}</button>
        <button data-profile-action="delete" data-profile-index="${index}">${t('btnDeleteProfile')}</button>
      </div>
    </div>`;
  }).join('');
  el.querySelectorAll('[data-profile-action]').forEach(button=>{
    button.onclick = () => {
      const index = Number(button.dataset.profileIndex);
      const currentProfiles = loadSavedProfiles();
      const profile = currentProfiles[index];
      if(!profile) return;
      if(button.dataset.profileAction==='active'){
        saveProfiles(currentProfiles, profile.id);
        renderSavedProfileBanner();
        generateAdvice();
      } else if(button.dataset.profileAction==='apply'){
        applySavedProfile(profile);
      } else if(button.dataset.profileAction==='rename'){
        const name = document.getElementById(`profileRename${index}`).value.trim();
        if(!name) return;
        currentProfiles[index] = {...profile,name};
        saveProfiles(currentProfiles, getActiveProfile(currentProfiles)?.id);
        renderSavedProfileBanner();
      } else if(button.dataset.profileAction==='retake'){
        editingProfileId = profile.id;
        creatingNewProfile = false;
        nameInput.value = profile.name;
        document.getElementById('invAge').value = profile.age||35;
        document.getElementById('invHorizon').value = profile.horizon||10;
        document.getElementById('profileResult').innerHTML = '';
        renderQuiz();
        renderSavedProfileBanner();
        document.getElementById('quizSection').scrollIntoView({behavior:'smooth',block:'start'});
      } else if(button.dataset.profileAction==='delete'){
        if(!window.confirm(t('confirmDeleteProfile'))) return;
        const wasActive = getActiveProfile(currentProfiles)?.id===profile.id;
        currentProfiles.splice(index,1);
        const fallbackOwner=currentProfiles[0]?.id||'profile-1';
        if(assetOwnerFilter===profile.id) assetOwnerFilter=currentProfiles[0]?.id||'all';
        let ownersChanged=false;
        tbody.querySelectorAll('[data-f="owner"]').forEach(select=>{
          if(select.value===profile.id){ select.value=fallbackOwner; ownersChanged=true; }
        });
        if(ownersChanged) savePortfolio();
        saveProfiles(currentProfiles, wasActive ? currentProfiles[0]?.id : getActiveProfile(currentProfiles)?.id);
        renderSavedProfileBanner();
        generateAdvice();
      }
    };
  });
  updateSimulationProfileOptions(profiles);
  tbody.querySelectorAll('[data-f="owner"]').forEach(select=>{
    const selected=select.value;
    select.innerHTML=profileOwnerOptions(selected);
  });
  renderAssetProfileBlocks();
  renderCompositionPies();
}
