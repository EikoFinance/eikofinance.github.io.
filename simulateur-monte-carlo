  ETF_LIST.forEach(e=>{ (byIssuer[e.issuer] = byIssuer[e.issuer]||[]).push(e); });
  const issuers = Object.keys(byIssuer).sort((a,b)=>a.localeCompare(b));
  document.getElementById('etfList').innerHTML = issuers.map(issuer=>{
    const rows = byIssuer[issuer].map(e=>{
      const idx = ETF_LIST.indexOf(e);
      return `<div class="etfRow">
        <div>
          <div class="etfName">${e.name} <span class="peaTag ${e.pea?'peaYes':'peaNo'}">${e.pea?t('peaYes'):t('peaNo')}</span></div>
          <div class="etfMeta"><span class="etfIsin">${e.isin}</span> · ${t('feeLabel')} ${e.ter}</div>
        </div>
        <div class="etfActions">
          <button data-copy="${e.isin}">${t('btnCopy')}</button>
          <button data-add="${idx}" class="primary">${t('btnAddEtf')}</button>
        </div>
      </div>`;
    }).join('');
    return `<div class="issuerGroup"><h3>${issuer}</h3>${rows}</div>`;
  }).join('');
  document.querySelectorAll('#etfList [data-copy]').forEach(btn=>{
    btn.onclick = async () => {
      try{ await navigator.clipboard.writeText(btn.dataset.copy); btn.textContent=t('btnCopied'); }
      catch(e){ btn.textContent='...'; }
      setTimeout(()=> btn.textContent=t('btnCopy'), 1500);
    };
  });
  document.querySelectorAll('#etfList [data-add]').forEach(btn=>{
    btn.onclick = () => {
      const e = ETF_LIST[parseInt(btn.dataset.add)];
      addAssetRow(e.name, e.isin, 0, 0, 0, e.cat);
      btn.textContent=t('btnAdded');
      setTimeout(()=> btn.textContent=t('btnAddEtf'), 1500);
    };
  });
}
