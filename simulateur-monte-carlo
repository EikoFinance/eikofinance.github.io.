function loadSavedProfiles(){
  try{
    const profiles = JSON.parse(localStorage.getItem('eiko_web_profiles')||'null');
    if(Array.isArray(profiles)) return profiles.slice(0,2);
  }catch(e){}
  try{
    const legacy = JSON.parse(localStorage.getItem('eiko_web_profile')||'null');
    if(legacy){
      const profile = {...legacy,id:'profile-1',name:legacy.name||t('profileDefault1')};
      localStorage.setItem('eiko_web_profiles', JSON.stringify([profile]));
      localStorage.setItem('eiko_web_active_profile_id', profile.id);
      return [profile];
    }
  }catch(e){}
  return [];
}
function getActiveProfile(profiles=loadSavedProfiles()){
  let activeId = '';
  try{ activeId = localStorage.getItem('eiko_web_active_profile_id')||''; }catch(e){}
  return profiles.find(profile=>profile.id===activeId) || profiles[0] || null;
}
function saveProfiles(profiles, activeId){
  const active = profiles.find(profile=>profile.id===activeId) || profiles[0] || null;
  try{
    localStorage.setItem('eiko_web_profiles', JSON.stringify(profiles));
    if(active){
      localStorage.setItem('eiko_web_active_profile_id', active.id);
      localStorage.setItem('eiko_web_profile', JSON.stringify(active));
    } else {
      localStorage.removeItem('eiko_web_active_profile_id');
      localStorage.removeItem('eiko_web_profile');
    }
  }catch(e){}
}
function escapeHtml(value){
  return String(value).replace(/[&<>"']/g, char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
}
function computeProfile(){
  let score=0, answered=0;
  QUESTIONS.forEach((item,i)=>{
    const sel = document.querySelector(`input[name="q${i}"]:checked`);
    if(sel){ score += parseInt(sel.value); answered++; }
  });
  if(answered < QUESTIONS.length){
    document.getElementById('profileResult').innerHTML = `<p style="color:var(--danger)">${t('profileIncomplete', QUESTIONS.length, answered)}</p>`;
    return;
  }
  const horizon = parseFloat(document.getElementById('invHorizon').value)||0;
  let band, bandIdx;
  if(score<=29){ band='prudent'; bandIdx=0; }
  else if(score<=58){ band='equilibre'; bandIdx=1; }
  else if(score<=87){ band='dynamique'; bandIdx=2; }
  else { band='offensif'; bandIdx=3; }
  const order=['prudent','equilibre','dynamique','offensif'];
  if(horizon>0 && horizon<3 && order.indexOf(band)>order.indexOf('equilibre')){ band='equilibre'; bandIdx=1; }
  const alloc = PROFILE_ALLOC[band];
  const allocStr = Object.keys(CATS).map(k=>`${catLabel(k)} ${alloc[k]}%`).join(' · ');
  document.getElementById('profileResult').innerHTML = `
    <div class="profile-result">
      <h3 style="margin:0 0 .5rem;">${t('profileResultTitle', t('profBand'+bandIdx), score, 117)}</h3>
      <p style="color:var(--muted);font-size:.88rem;">${t('profileAllocLabel')} ${allocStr}</p>
      <div class="row-actions">
        <button id="applyProfile">${t('btnApplyProfile')}</button>
        <button id="saveProfile">${t('btnSaveProfile')}</button>
      </div>
    </div>`;
  document.getElementById('saveProfile').onclick = () => {
    try{
      const profiles = loadSavedProfiles();
      const oldProfile = profiles.find(profile=>profile.id===editingProfileId);
      if(!oldProfile && profiles.length>=2){ alert(t('profileLimitReached')); return; }
      const name = document.getElementById('profileNameInput').value.trim() || (oldProfile?.name || t(profiles.length ? 'profileDefault2' : 'profileDefault1'));
      const profile = {id:oldProfile?.id||`profile-${Date.now().toString(36)}`,name,score,bandIdx,age:document.getElementById('invAge').value,horizon,ts:Date.now()};
      const updated = oldProfile ? profiles.map(item=>item.id===oldProfile.id ? profile : item) : [...profiles,profile];
      saveProfiles(updated, profile.id);
      editingProfileId = null;
      creatingNewProfile = false;
      renderSavedProfileBanner();
      document.getElementById('profileResult').innerHTML = '';
    }catch(e){}
  };
  document.getElementById('applyProfile').onclick = () => {
    const assets = getAssets().filter(a=>a.weight>0);
    const totalW = assets.reduce((s,a)=>s+a.weight,0)||1;
    const catTotal = {}; for(const k in CATS) catTotal[k]=0;
    assets.forEach(a=> catTotal[a.cat] += a.weight);
    const unassigned = [];
    for(const k in alloc){ if(catTotal[k]===0 && alloc[k]>0) unassigned.push(`${catLabel(k)} (${alloc[k]}%)`); }
    assets.forEach(a=>{
      const share = catTotal[a.cat]>0 ? (a.weight/catTotal[a.cat]) : 0;
      assetTargets[a.name] = (alloc[a.cat]*share).toFixed(1);
    });
    switchTab('t4');
    calcStrategy();
    if(unassigned.length) document.getElementById('stratResult').insertAdjacentHTML('afterbegin',
      `<p style="color:var(--accent2);font-size:.85rem;">${t('unassigned', unassigned.join(', '))}</p>`);
  };
}
