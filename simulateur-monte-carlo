function savePortfolio(){
  const rows = [...tbody.querySelectorAll('tr')].map(tr=>({
    name: tr.querySelector('[data-f="name"]').value,
    ownerId: tr.querySelector('[data-f="owner"]').value,
    isin: tr.querySelector('[data-f="isin"]').value,
    issuer: tr.querySelector('[data-f="issuer"]').value,
