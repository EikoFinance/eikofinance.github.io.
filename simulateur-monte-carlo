          :`${catLabel(k)} at ${byCat[k].toFixed(0)}% vs ${alloc[k]}% target (${goalLabel}) — consider ${gap>0?'increasing':'reducing'} by about ${Math.abs(gap).toFixed(0)} pts.`);
      } else {
        tips.push(fr?`${catLabel(k)} à ${byCat[k].toFixed(0)}% — déjà proche de la cible de ${alloc[k]}% (${goalLabel}), pas d'ajustement nécessaire.`
          :`${catLabel(k)} at ${byCat[k].toFixed(0)}% — already close to the ${alloc[k]}% target (${goalLabel}), no adjustment needed.`);
